@startuml
' Restoration outcomes after ID validation; input loop and decorative output are omitted.
hide footbox
skinparam defaultFontSize 14
skinparam maxMessageSize 145

participant ":CommandHandler" as CH
participant ":TrashcanCommandHandler" as TCH
participant ":TrashcanManager" as TM
participant ":ClientManager" as CM
participant ":Ui" as UI

alt retained client exists and ID is available
  CH -> TCH : execute(restoreCommand)
  activate CH
  activate TCH
  TCH -> TCH : validate one client ID
  activate TCH
  deactivate TCH
  TCH -> TM : restoreClient("C001", clientManager)
  activate TM
  TM -> TM : find retained client
  activate TM
  deactivate TM
  TM -> CM : registerRestoredClient(client)
  activate CM
  CM -> CM : check active client ID
  activate CM
  deactivate CM
  CM -> CM : add client with original notes
  activate CM
  deactivate CM
  CM --> TM : registration complete
  deactivate CM
  TM -> TM : remove retained client entry
  activate TM
  deactivate TM
  TM --> TCH : restored client
  deactivate TM
  TCH -> UI : show restoration message
  activate UI
  deactivate UI
  TCH --> CH
  deactivate TCH
  deactivate CH

else active client ID conflicts
  CH -> TCH : execute(restoreCommand)
  activate CH
  activate TCH
  TCH -> TCH : validate one client ID
  activate TCH
  deactivate TCH
  TCH -> TM : restoreClient("C001", clientManager)
  activate TM
  TM -> TM : find retained client
  activate TM
  deactivate TM
  TM -> CM : registerRestoredClient(client)
  activate CM
  CM -> CM : check active client ID
  activate CM
  deactivate CM
  CM --> TM : ClientException
  deactivate CM
  TM --> TCH : propagate exception
  deactivate TM
  TCH --> CH : propagate exception
  deactivate TCH
  CH -> UI : show error and usage
  activate UI
  deactivate UI
  note over TM, CM
    Active client and retained snapshot are unchanged.
  end note
  deactivate CH

else no retained client
  CH -> TCH : execute(restoreCommand)
  activate CH
  activate TCH
  TCH -> TCH : validate one client ID
  activate TCH
  deactivate TCH
  TCH -> TM : restoreClient("C001", clientManager)
  activate TM
  TM -> TM : find retained client
  activate TM
  deactivate TM
  TM --> TCH : ClientException
  deactivate TM
  TCH --> CH : propagate exception
  deactivate TCH
  CH -> UI : show error and usage
  activate UI
  deactivate UI
  deactivate CH
end

note over TM, CM
  ID counters are unchanged.
  Deleted projects require separate restore commands.
end note
@enduml
