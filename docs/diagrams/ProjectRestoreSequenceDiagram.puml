@startuml
' Restoration outcomes for a retained project; input loop and decorative output are omitted.
hide footbox
skinparam defaultFontSize 14
skinparam maxMessageSize 145

participant ":CommandHandler" as CH
participant ":TrashcanCommandHandler" as TCH
participant ":TrashcanManager" as TM
participant ":ProjectManager" as PM
participant ":Ui" as UI

alt registration succeeds
  CH -> TCH : execute(restoreCommand)
  activate CH
  activate TCH
  note right of TCH
    validate one project ID
  end note
  TCH -> TM : restoreProject("P001", projectManager)
  activate TM
  note right of TM
    find retained project
  end note
  TM -> PM : registerRestoredProject(project)
  activate PM
  note right of PM
    check active client and ID conflicts
  end note
  note right of PM
    add project to active collection
  end note
  PM -> PM : sortProjectsById()
  activate PM
  deactivate PM
  PM --> TM : registration complete
  deactivate PM
  note right of TM
    remove retained project entry
  end note
  TM --> TCH : restored project
  deactivate TM
  TCH -> UI : show restoration message
  activate UI
  deactivate UI
  TCH --> CH
  deactivate TCH
  deactivate CH

else registration fails
  CH -> TCH : execute(restoreCommand)
  activate CH
  activate TCH
  note right of TCH
    validate one project ID
  end note
  TCH -> TM : restoreProject("P001", projectManager)
  activate TM
  note right of TM
    find retained project
  end note
  TM -> PM : registerRestoredProject(project)
  activate PM
  note right of PM
    check active client and ID conflicts
  end note
  PM --> TM : validation exception
  deactivate PM
  TM --> TCH : propagate exception
  deactivate TM
  TCH --> CH : propagate exception
  deactivate TCH
  CH -> UI : show error and usage
  activate UI
  deactivate UI
  note over TM, PM
    Retained project remains available.
  end note
  deactivate CH
end
@enduml
