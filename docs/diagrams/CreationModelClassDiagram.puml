@startuml
' Model classes used by project.add, task.add and event.add.
' The smetana layout renders class diagrams without a separate Graphviz install.
!pragma layout smetana
hide circle
hide empty members
skinparam classAttributeIconSize 0

class ProjectManager {
  -nextProjectNumber : int
  -nextTaskNumber : int
  -nextEventNumber : int
  +addProject(clientId, name, deadline) : Project
  +addTask(projectId, description, date) : Task
  +addEvent(projectId, description, date) : Event
  +getProject(projectId) : Project
}

interface ClientLookup <<interface>> {
  +exists(clientId) : boolean
}

class ClientManager

class Project {
  -projectId : String
  -clientId : String
  -name : String
  -deadline : LocalDate
  -status : ProjectStatus
  +addTask(task)
  +addEvent(event)
  +getTasks() : List<Task>
  +getEvents() : List<Event>
}

abstract class ScheduledItem {
  -id : String
  -description : String
  -date : LocalDate
  {abstract} +getType() : String
}

class Task {
  -completed : boolean
}

class Event

' Each association enters Project from a different side so its role name and
' multiplicity stay visible; role names sit beside the multiplicity at the target end.
ProjectManager -left-> "clientLookup 1" ClientLookup
ClientManager .up.|> ClientLookup
ProjectManager *-right-> "projects *" Project
Project *-down-> "tasks *" Task
Project *-down-> "events *" Event
ScheduledItem -left-> "project 1" Project
Task -up-|> ScheduledItem
Event -up-|> ScheduledItem
@enduml
