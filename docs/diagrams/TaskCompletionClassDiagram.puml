@startuml
' Classes responsible for task completion and its persisted state.
skinparam classAttributeIconSize 0
hide empty members

class ProjectManager {
  +getTask(taskId): Task
  +markTaskComplete(taskId): Task
  +markTaskIncomplete(taskId): Task
  +getProjects(): List<Project>
}

class Project {
  +getTasks(): List<Task>
}

class Task {
  -completed: boolean
  +isCompleted(): boolean
  +markCompleted(): void
  +markIncomplete(): void
}

class DataStorage {
  +save(clients, projects): void
  +load(): LoadedData
}

class Ui {
  +showProjectSummary(project, client): void
}

ProjectManager "1" o-- "0..*" Project : stores
Project "1" *-- "0..*" Task : contains
DataStorage ..> ProjectManager : reads / reconstructs
DataStorage ..> Task : persists completed
Ui ..> Project : reads tasks
Ui ..> Task : counts completed

@enduml
